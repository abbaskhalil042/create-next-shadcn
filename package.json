{
  "name": "create-nextjs-shadcn",
  "version": "1.0.5",
  "type": "module",
  "bin": {
    "create-next-shadcn": "./bin/create-nextjs-shadcn.js"
  },
  "files": [
    "bin",
    "template"
  ],
  "scripts": {
    "prepare": "npm run build && husky install",
    "build": "tsc && chmod +x bin/create-nextjs-shadcn.js",
    "dev": "npm run build && npm link && create-nextjs-shadcn test-app --local",
    "test": "npm run test:create",
    "prepublishOnly": "npm run build",
    "test:create": "node bin/create-nextjs-shadcn.js test-app --ci",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "release": "standard-version"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "inquirer": "^9.3.7",
    "ora": "^6.3.1"
  },
  "devDependencies": {
    "@types/chalk": "^2.2.0",
    "@types/eslint": "^9.6.1",
    "@types/inquirer": "^9.0.4",
    "@types/node": "^22.15.17",
    "@types/ora": "^3.1.0",
    "eslint": "^9.26.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.0",
    "prettier": "^3",
    "standard-version": "^9.5.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abbaskhalil042/create-next-shadcn.git"
  },
  "keywords": [
    "nextjs",
    "shadcn",
    "starter-kit",
    "cli"
  ]
}
